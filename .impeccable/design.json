  "narrative": {
    "northStar": "A Clear Payment Path",
    "overview": "Avenra makes payment activity feel composed and legible. Deep evergreen anchors the identity, warm ivory creates reading space, and lime marks a deliberate choice. The visual language pairs confident, closely spaced headings with precise tables, labelled statuses, and compact operational controls.\n\nUse the original A mark, locally hosted Manrope, restrained borders, and short state transitions as the common vocabulary. The company site can breathe while the merchant workspace remains denser; both use the same palette and attention to clear outcomes. These are implementation-derived conventions for the working Avenra identity.",
    "keyCharacteristics": [
      "Evergreen structure, ivory reading surfaces, and lime selected states.",
      "Manrope headings and tabular payment amounts.",
      "Quiet bordered cards and compact, labelled controls.",
      "Visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Foreground Rule",
        "body": "Use evergreen text on lime, and white or ivory text on evergreen. Lime on a light surface is an accent rather than small body text.",
        "section": "colors"
      },
      {
        "name": "The Status Rule",
        "body": "Every payment status carries a text label. Its colored dot and tinted background reinforce that label.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Keep operational text at the final readability overrides: default desktop controls and table content use 12px, navigation uses 13px, and status badges use 10px. Do not copy superseded smaller base declarations when extending the workspace.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Separate normal workspace cards with a light border and an almost imperceptible shadow. Stronger shadows identify overlays or lifted previews.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the evergreen, lime, and ivory color assignments from the normative frontmatter.",
      "Do use the original A mark and self-hosted Manrope across new product surfaces.",
      "Do pair status colors with readable text and align amounts with tabular numerals.",
      "Do preserve visible keyboard focus, accessible control names, and reduced-motion behavior.",
      "Do keep sample data and demo actions visibly identified."
    ],
    "donts": [
      "Don't substitute a different mark, remotely loaded display font, or unrelated accent palette.",
      "Don't communicate a payment outcome through color alone.",
      "Don't shrink new operational labels to the superseded tiny base styles.",
      "Don't add looping decorative motion to the implemented finite routing animation.",
      "Don't treat the demonstration UI as evidence of a live payment service."
    ]
  }
}
