  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared company-page action with a restrained evergreen hover.",
      "html": "<button class=\"ds-button-primary\">Explore the workspace<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 20px;border:1px solid transparent;border-radius:8px;font-family:Manrope,Arial,sans-serif;font-size:14px;font-weight:650;text-decoration:none;transition:background .2s,color .2s;cursor:pointer;background:var(--ink,#153c32);color:var(--white,#ffffff)}.ds-button-primary:hover{background:var(--green,#1d5c45)}.ds-button-primary:focus-visible{outline:3px solid #438467;outline-offset:4px;}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;animation:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A pale bordered alternative to the shared primary action.",
      "html": "<button class=\"ds-button-secondary\">View source</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 20px;border:1px solid transparent;border-radius:8px;font-family:Manrope,Arial,sans-serif;font-size:14px;font-weight:650;text-decoration:none;transition:background .2s,color .2s;cursor:pointer;background:var(--white,#ffffff);border-color:var(--line,#e2e7df);color:var(--ink,#153c32)}.ds-button-secondary:hover{background:#eef2e8}.ds-button-secondary:focus-visible{outline:3px solid #438467;outline-offset:4px;}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;animation:none}}"
    },
    {
      "name": "Lime button",
      "kind": "button",
      "refersTo": "button-lime",
      "description": "A bright action for an evergreen surface.",
      "html": "<div class=\"ds-dark-surface\"><button class=\"ds-button-lime\">Step inside the demo<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></div>",
      "css": ".ds-dark-surface{background:var(--ink,#153c32);padding:24px;border-radius:12px}.ds-button-lime{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:12px 20px;border:1px solid transparent;border-radius:8px;font-family:Manrope,Arial,sans-serif;font-size:14px;font-weight:650;text-decoration:none;transition:background .2s,color .2s;cursor:pointer;padding:14px 20px;font-size:13px;background:var(--lime,#d7ef8a);color:var(--ink,#153c32)}.ds-button-lime:hover{background:#e5f6b3}.ds-button-lime:focus-visible{outline:3px solid #438467;outline-offset:4px;}.ds-button-lime:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-lime,.ds-dark-surface{transition:none;animation:none}}"
    },
    {
      "name": "Workspace primary button",
      "kind": "button",
      "refersTo": "workspace-button-primary",
      "description": "A compact operational action with the final readable label size.",
      "html": "<button class=\"ds-workspace-button\">Save demo routing</button>",
      "css": ".ds-workspace-button{display:inline-flex;align-items:center;justify-content:center;gap:7px;border-radius:6px;padding:9px 12px;min-height:36px;font-family:Manrope,Arial,sans-serif;font-size:12px;line-height:1.5;font-weight:600;white-space:nowrap;background:var(--green,#1d5c45);color:#f4f8e8;border:1px solid var(--green,#1d5c45);transition:background .18s,border-color .18s,color .18s;cursor:pointer}.ds-workspace-button:hover:not(:disabled){background:#174a37}.ds-workspace-button:focus-visible{outline:2px solid #6d9850;outline-offset:4px;}.ds-workspace-button:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-workspace-button{transition:none;animation:none}}"
    },
    {
      "name": "Workspace field",
      "kind": "input",
      "refersTo": "workspace-input",
      "description": "A labelled merchant field with workspace focus treatment.",
      "html": "<label class=\"ds-field\"><span>Merchant name</span><input type=\"text\" value=\"Avenra demo\" placeholder=\"Enter a name\"/></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:#617750;font-family:Manrope,Arial,sans-serif;font-weight:550;font-size:12px;line-height:1.5;max-width:320px}.ds-field input{width:100%;background:var(--white,#ffffff);border:1px solid #dce5d2;border-radius:6px;padding:11px 12px;font-family:Manrope,Arial,sans-serif;font-size:12px;line-height:1.5;font-weight:550;color:#36582a;min-height:39px;caret-color:var(--green,#1d5c45)}.ds-field input::placeholder{color:#9eaf91;font-weight:400}.ds-field input:focus-visible{outline:2px solid #6d9850;outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-field{transition:none;animation:none}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "refersTo": "workspace-navigation",
      "description": "Sidebar destinations with a lime active state and explicit focus.",
      "html": "<nav class=\"ds-navigation\" aria-label=\"Workspace preview\"><button class=\"ds-nav-item ds-nav-active\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview<span class=\"ds-nav-indicator\"></span></button><button class=\"ds-nav-item\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" aria-hidden=\"true\"><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"/><path d=\"M2 10h20M6 15h3\"/></svg>Payments</button></nav>",
      "css": ".ds-navigation{display:flex;flex-direction:column;gap:4px;max-width:244px;background:#123b31;padding:20px;border-radius:10px}.ds-nav-item{display:flex;align-items:center;gap:13px;width:100%;border:0;border-radius:7px;background:transparent;color:#b4c8b9;padding:12px 15px;text-align:left;font-family:Manrope,Arial,sans-serif;font-size:13px;line-height:1.5;transition:background .2s,color .2s;cursor:pointer}.ds-nav-item:hover{color:#f1f6e9;background:#234c3d}.ds-nav-item:focus-visible{outline:2px solid #6d9850;outline-offset:4px;}.ds-nav-active,.ds-nav-active:hover{background:var(--lime,#d7ef8a);color:#244b34;font-weight:650}.ds-nav-indicator{width:5px;height:5px;background:#386245;border-radius:50%;margin-left:auto}@media(prefers-reduced-motion:reduce){.ds-nav-active,.ds-nav-indicator,.ds-nav-item,.ds-navigation{transition:none;animation:none}}"
    },
    {
      "name": "Payment statuses",
      "kind": "chip",
      "refersTo": "status-succeeded",
      "description": "Each payment state pairs a label, colored dot, and pale background.",
      "html": "<div class=\"ds-status-list\"><span class=\"ds-status ds-success\"><span></span>Succeeded</span><span class=\"ds-status ds-pending\"><span></span>Pending</span><span class=\"ds-status ds-failed\"><span></span>Failed</span><span class=\"ds-status ds-refunded\"><span></span>Refunded</span></div>",
      "css": ".ds-status-list{display:flex;flex-wrap:wrap;gap:8px}.ds-status{display:inline-flex;align-items:center;gap:5px;font-family:Manrope,Arial,sans-serif;font-size:10px;line-height:1.5;font-weight:550;border-radius:4px;padding:4px 6px;white-space:nowrap}.ds-status>span{width:4px;height:4px;border-radius:50%;background:currentColor}.ds-success{color:#476c37;background:#edf5e7}.ds-pending{color:#80691f;background:#fbf4df}.ds-failed{color:#974d3b;background:#fbefeb}.ds-refunded{color:#70528c;background:#f1eef9}@media(prefers-reduced-motion:reduce){.ds-failed,.ds-pending,.ds-refunded,.ds-status,.ds-status-list,.ds-success{transition:none;animation:none}}"
